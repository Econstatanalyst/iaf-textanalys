iaf_dtm <- iaf_ord_filtrerat %>%
count(filnamn, ord) %>%
cast_dtm(filnamn, ord, n)
message("DTM skapad: ", nrow(iaf_dtm), " dokument, ", ncol(iaf_dtm), " unika ord")
# ------------------------------------------------------------
# STEG 2: Kör LDA med 6 topics
# ------------------------------------------------------------
set.seed(123)  # För reproducerbarhet
iaf_lda <- LDA(iaf_dtm, k = 6, control = list(seed = 123))
message("LDA klar!")
# ------------------------------------------------------------
# STEG 3: Extrahera de viktigaste orden per topic
# ------------------------------------------------------------
iaf_topics <- tidy(iaf_lda, matrix = "beta")
# ------------------------------------------------------------
# STEG 4: Visualisera top 10 ord per topic.
# ------------------------------------------------------------
iaf_topics %>%
group_by(topic) %>%
slice_max(beta, n = 10) %>%
ungroup() %>%
ggplot(aes(x = reorder_within(term, beta, topic),
y = beta, fill = factor(topic))) +
geom_col(show.legend = FALSE) +
facet_wrap(~topic, scales = "free_y") +
coord_flip() +
scale_x_reordered() +
labs(
title = "LDA – Topp 10 ord per tema",
subtitle = "Beta = sannolikhet att ordet tillhör temat",
x = NULL,
y = "Beta"
) +
theme_minimal()
iaf_topics_wide <- iaf_topics %>%
mutate(topic = paste0("tema_", topic)) %>%
pivot_wider(names_from = topic, values_from = beta) %>%
filter_all(any_vars(!is.na(.))) %>%
replace(is.na(.), 0)
# Hitta ord som särskiljer teman från varandra
iaf_topics_wide <- iaf_topics %>%
mutate(topic = paste0("tema_", topic)) %>%
pivot_wider(names_from = topic, values_from = beta) %>%
filter_all(any_vars(!is.na(.))) %>%
replace(is.na(.), 0)
library(tidyr)
# Hitta ord som särskiljer teman från varandra
iaf_topics_wide <- iaf_topics %>%
mutate(topic = paste0("tema_", topic)) %>%
pivot_wider(names_from = topic, values_from = beta) %>%
filter_all(any_vars(!is.na(.))) %>%
replace(is.na(.), 0)
# Beräkna hur unikt varje ord är för varje tema
# genom att jämföra med genomsnittet av alla andra teman
iaf_topics_unikt <- iaf_topics %>%
group_by(term) %>%
mutate(
medel_andra = (sum(beta) - beta) / (n() - 1),  # Snitt för övriga teman
unicitet = beta / (medel_andra + 0.0001)         # Hur mycket högre än snittet
) %>%
ungroup()
# Visualisera top 10 mest unika ord per tema
iaf_topics_unikt %>%
group_by(topic) %>%
slice_max(unicitet, n = 10) %>%
ungroup() %>%
ggplot(aes(x = reorder_within(term, unicitet, topic),
y = unicitet, fill = factor(topic))) +
geom_col(show.legend = FALSE) +
facet_wrap(~topic, scales = "free_y") +
coord_flip() +
scale_x_reordered() +
labs(
title = "Mest unika ord per tema (jämfört med övriga teman)",
subtitle = "Unicitet = hur mycket vanligare ordet är i detta tema vs andra",
x = NULL,
y = "Unicitet"
) +
theme_minimal()
# Extrahera gamma - hur mycket varje dokument tillhör varje tema
iaf_gamma <- tidy(iaf_lda, matrix = "gamma")
# Lägg till år från filnamnet
iaf_gamma <- iaf_gamma %>%
mutate(ar = str_extract(document, "20[0-9]{2}"))
# Namnge temana
tema_namn <- c(
"1" = "Sanktionsprövningar och likabehandling",
"2" = "Arbetsförmedlingens anvisningar och matchning",
"3" = "A-kassornas ekonomi och förvaltning",
"4" = "Statistiska uppföljningar av arbetsmarknadsåtgärder",
"5" = "Felaktiga utbetalningar och bidragsbrott",
"6" = "Uppföljning av arbetsmarknadsåtgärder och regelefterlevnad"
)
iaf_gamma <- iaf_gamma %>%
mutate(tema = tema_namn[as.character(topic)])
# Beräkna genomsnittlig temaandel per år
iaf_tema_ar <- iaf_gamma %>%
group_by(ar, tema) %>%
summarise(gamma = mean(gamma), .groups = "drop")
# Visualisera
ggplot(iaf_tema_ar, aes(x = ar, y = gamma, fill = tema)) +
geom_col(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Temafördelning i IAF:s rapporter per år",
subtitle = "Baserat på LDA med 6 teman",
x = NULL,
y = "Andel",
fill = "Tema"
) +
theme_minimal() +
theme(legend.position = "bottom",
legend.text = element_text(size = 7)) +
guides(fill = guide_legend(ncol = 2))
# Visualisera
ggplot(iaf_tema_ar, aes(x = ar, y = gamma, fill = tema)) +
geom_col(position = "fill") +
scale_y_continuous(labels = scales::percent) +
scale_fill_manual(values = c(
"#E69F00", "#56B4E9", "#009E73",
"#F0E442", "#0072B2", "#D55E00"
)) +
labs(
title = "Temafördelning i IAF:s rapporter per år",
subtitle = "Baserat på LDA med 6 teman",
x = NULL,
y = "Andel",
fill = "Tema"
) +
theme_minimal() +
theme(
legend.position = "bottom",
legend.text = element_text(size = 8),
legend.title = element_text(size = 9)
) +
guides(fill = guide_legend(ncol = 2))
